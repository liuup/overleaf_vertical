{
  "manifest_version": 3,
  "name": "Overleaf Vertical Split",
  "version": "1.1.0",
  "description": "Force Overleaf editor and preview to display top-bottom instead of side-by-side.",
  "icons": {
    "48": "./icon.png"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "*://www.overleaf.com/*",
        "*://cn.overleaf.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
